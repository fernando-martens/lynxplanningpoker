<Layouts.app_header conn={@conn} />
<main class="mx-auto max-w-lg px-6 py-12">
  <section>
    <div class="text-center">
      <div class="mx-auto flex h-28 w-28 items-center justify-center rounded-full bg-base-200 shadow-inner">
        <img src="/images/lynx.svg" alt="Lynx Mascot" class="h-20 w-20 object-contain" />
      </div>

      <h1 class="mt-8 text-4xl font-semibold tracking-tight">{gettext("Start a new session")}</h1>

      <p class="mx-auto mt-3 max-w-2xl text-base text-base-content/70">
        {gettext(
          "Click below to create your room. We'll give you a temporary name — change it whenever you like inside."
        )}
      </p>
    </div>

    <.form for={%{}} action={@action} id="create-room-form" method="post" class="mt-5 space-y-6">
      <%!-- Filled in by app.js with the name this browser already knows, so
      someone who named themselves once never has to do it again. Empty on a
      first visit: the server generates a temporary name. --%>
      <input type="hidden" name="user[name]" value="" data-remembered-name />
      <%= if @turnstile_site_key do %>
        <div class="flex justify-center">
          <div
            class="cf-turnstile"
            data-sitekey={@turnstile_site_key}
            data-callback="lynxTurnstileEnable"
            data-error-callback="lynxTurnstileEnable"
            data-expired-callback="lynxTurnstileDisable"
          >
          </div>
        </div>

        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer>
        </script>
      <% end %>

      <.button
        type="submit"
        disabled={@turnstile_site_key != nil}
        class="w-full py-5 text-lg font-semibold"
      >
        {gettext("Create room")}
      </.button>
    </.form>
  </section>
</main>
