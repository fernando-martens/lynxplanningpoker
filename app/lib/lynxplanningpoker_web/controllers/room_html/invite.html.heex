<Layouts.app_header conn={@conn} />
<main class="mx-auto max-w-lg px-6 py-12">
  <section>
    <div class="text-center">
      <div class="mx-auto flex h-28 w-28 items-center justify-center rounded-full bg-base-200 shadow-inner">
        <img src="/images/lynx.svg" alt="Lynx Mascot" class="h-20 w-20 object-contain" />
      </div>

      <h1 class="mt-8 text-4xl font-semibold tracking-tight">{gettext("You're invited!")}</h1>

      <p class="mx-auto mt-3 max-w-2xl text-base text-base-content/70">
        {gettext(
          "Click Join to enter the room. We'll give you a temporary name — change it whenever you like inside."
        )}
      </p>
    </div>

    <.form for={%{}} action={@action} method="post" class="mt-5 space-y-6">
      <.button type="submit" class="w-full py-5 text-lg font-semibold">
        {gettext("Join the room")}
      </.button>
    </.form>
  </section>
</main>
